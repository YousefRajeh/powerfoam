.vscode

*.egg-info
__pycache__
/*nsight
*.mp4
*ipynb
*.sh

/data
/output*
/logs
/artifacts

# One-off run logs and build-diagnostic transcripts from the gsplat baseline
# work (gsplat_baseline/*, and gsplat_*_build*.txt at the repo root) -- never
# meant to be committed, just kept locally for debugging a given run.
gsplat_baseline/*_log*.txt
gsplat_build_log*.txt
gsplat_gsview_build*.txt

# Same convention, extended to the room_0/LERF-OVS session's own one-off run
# logs, build-diagnostic transcripts, and pip-install fragments -- kept
# locally for debugging, never meant to be committed.
*.log
*_ascii.txt
*_ascii[0-9].txt
*_log.txt
requirements_*.txt
gsplat_baseline/*.log

# marimo's own session cache -- regenerated locally, not project state.
notebooks/__marimo__/

# Large local model/checkpoint cache, not project source.
/checkpoints
# 3.2GB of Gaussian baseline checkpoints/features -- data, not code
/gaussian_baseline_scannet
smoke_whitepad/
smoke6/
configs/_tf_*.yaml
.reextract_whitepad.lock

# Orchestration scripts are versioned deliberately; scratch *.sh above stays ignored.
!scripts/remote/*.sh
/recon_remote
