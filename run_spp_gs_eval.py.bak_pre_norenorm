    if "--outdir" in sys.argv: kw["outdir"] = sys.argv[sys.argv.index("--outdir") + 1]
    if "--text-lowdin" in sys.argv: kw["text_lowdin"] = True
    run(**kw)
    print("GS_EVAL DONE")
